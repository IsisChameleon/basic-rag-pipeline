# Copy this file to .env and fill in real values. .env is gitignored and
# never committed.

# Required by /answer: Gemini API key for answer generation. Create one at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: raises the Hugging Face Hub rate limit for downloading the
# embedding/reranker models. Get a free "Read" token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: host port the api service is exposed on. Defaults to 8000.
API_PORT=

# Optional: Langfuse tracing. Leave the keys blank to disable (the SDK no-ops
# and the pipeline runs exactly as before). To collect per-stage traces, start
# the stack with `docker compose --profile langfuse up` and set the keys below.
# These fixed dev values match what the langfuse-web container auto-provisions
# on first boot (see docs/langfuse.md). LANGFUSE_HOST is the in-network address
# of langfuse-web; leave it as-is when running via docker compose.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
