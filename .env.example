# Copy this file to .env and fill in real values. .env is gitignored and
# never committed.

# Optional: raises the Hugging Face Hub rate limit for downloading the
# embedding/reranker models. Get a free "Read" token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: host port the api service is exposed on. Defaults to 8000.
API_PORT=
